{
  "name": "mda-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard da Mentoria MDA — funil high-ticket (Caio). One-page, dados de Google Sheets, acesso protegido.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web",
    "test": "npm run test --workspace server",
    "build": "npm run build --workspace web && npm run build --workspace server",
    "dev": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "sync": "npm run sync --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.1",
    "typescript": "^5.7.2"
  }
}
