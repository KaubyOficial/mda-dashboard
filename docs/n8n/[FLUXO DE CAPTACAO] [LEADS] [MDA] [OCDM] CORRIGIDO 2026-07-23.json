      "parameters": {
        "jsCode": "const item = $input.item.json;\n// Robusto aos dois formatos: form mandando JSON string (body chega string)\n// ou application/json (body já chega objeto). Antes: JSON.parse em objeto quebrava.\nconst body = typeof item.body === 'string' ? JSON.parse(item.body) : item.body;\nconst headers = item.headers;\n\nreturn {\n  // === LEAD ===\n  lead: {\n    nome:          body.name,\n    email:         body.email,\n    telefone:      body.cellphone,\n    pontos:        body.pontos_leads,\n    classificacao: body.classificacao,\n    data_envio:    body.data_envio,\n  },\n\n  // === RESPOSTAS DO FORMULÁRIO ===\n  // Mapeamento vigente do form atual (índices realinhados após a mudança do formulário).\n  respostas: {\n    tempo_que_conhece: body.resposta4,\n    situacao_atual: body.resposta5,\n    impacto_vida: body.resposta6,\n    tem_canal: body.resposta7,\n    tipo_conteudo: body.resposta11,\n    inscritos_canal: body.resposta8,\n    horas_por_semana: body.resposta12,\n    prontidao_mentoria: body.resposta13,\n    motivo_mentoria: body.resposta14,\n    por_que_escolhido: body.resposta15,\n    confirmacao_call: body.resposta16,\n  },\n\n  // === UTMs / TRÁFEGO ===\n  utm: {\n    source:       body.OCDM_utm_source,\n    medium:       body.OCDM_utm_medium,\n    campaign:     body.OCDM_utm_campaign,\n    content:      body.OCDM_utm_content,\n    term:         body.OCDM_utm_term,\n    url_completa: body.OCDM_url_window,\n  },\n\n  // === META / REQUEST ===\n  meta: {\n    ip:             headers[\"x-real-ip\"],\n    origem:         headers.origin,\n    user_agent:     headers[\"user-agent\"],\n    webhook_url:    item.webhookUrl,\n    execution_mode: item.executionMode,\n  },\n};"
      },
