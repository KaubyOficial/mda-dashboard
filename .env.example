# ── MDA Dashboard — variáveis de ambiente ──
# Copie para .env (nunca comitar). §5.4 do PLANO-MESTRE.

# Fonte de dados: csv | mock | sheet-csv | sheet-api
#   csv       = lê os exports locais reais de RESPOSTAS/LEADS (dev, dados que já temos)
#   mock      = gera dados sintéticos de todas as 6 entidades (UI dev sem planilha)
#   sheet-csv = CÓPIA via link "qualquer pessoa com o link" (export CSV por gid) — V1 dev
#   sheet-api = Google Sheets API v4 read-only + service account — PRODUÇÃO
DATA_SOURCE=mock

# --- modo csv (exports locais) ---
CSV_RESPOSTAS_PATH=
CSV_LEADS_PATH=

# --- modo sheet-csv (CÓPIA por link) ---
# ID da CÓPIA "Mestres do Algoritmo _ OCDM" (Kauê liberou "qualquer pessoa com o link").
SHEET_ID=1Y2swiHYvyxYADG6rD1hKuu8LTyM_lvx8GJue6zk0y3A
# gids REAIS das 7 abas do funil OCDM/APLICAÇÃO (mapeados 2026-07-07). Abas C2 ficam de fora da V1.
SHEET_GID_LEADS=563141629
SHEET_GID_AGENDAMENTOS=1902127266
SHEET_GID_VENDAS=7064037
SHEET_GID_MIDIA_DIARIA=1191656695
SHEET_GID_MIDIA_PUBLICO=412418203
SHEET_GID_MIDIA_ANUNCIO=449290879
# RESPOSTAS é redundante (LEADS já traz MQL) — não usado na V1.
SHEET_GID_RESPOSTAS=1946617532

# --- modo sheet-api (produção) ---
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# --- sync ---
SYNC_INTERVAL_MINUTES=20
TIMEZONE=America/Sao_Paulo
CURRENCY=BRL
# Ticket usado só como fallback quando a venda não traz valor (glossário §4: valor real vence)
DEFAULT_TICKET=4297

# --- servidor ---
PORT=8080
HOST=127.0.0.1

# --- segurança (Epic 5) ---
# Domínio do time Cloudflare Access (ex.: kaubymedia.cloudflareaccess.com)
CF_ACCESS_TEAM_DOMAIN=
# AUD tag do app Access
CF_ACCESS_AUD=
# Em dev, pular validação do JWT do Access (SOMENTE localhost)
AUTH_BYPASS=true
