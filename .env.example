# ── MDA Dashboard — variáveis de ambiente ──
# Copie para .env (nunca comitar). §5.4 do PLANO-MESTRE.

# Fonte de dados: csv | mock | sheet-csv | sheet-api
#   csv       = lê os exports locais reais de RESPOSTAS/LEADS (dev, dados que já temos)
#   mock      = gera dados sintéticos de todas as 6 entidades (UI dev sem planilha)
#   sheet-csv = CÓPIA CONGELADA via link público (export CSV por gid) — só dev
#   sheet-api = Google Sheets API v4 read-only + service account — PRODUÇÃO (planilha REAL)
#
# ⚠️ sheet-csv exige a planilha em "qualquer pessoa com o link". A planilha REAL tem PII
# de lead (nome/telefone/e-mail) e NÃO deve ser pública → produção = sheet-api.
DATA_SOURCE=sheet-api

# --- modo csv (exports locais) ---
CSV_RESPOSTAS_PATH=
CSV_LEADS_PATH=

# --- planilha (usado por sheet-csv e sheet-api) ---
# ID = o trecho entre /d/ e /edit na URL da planilha.
#   PRODUÇÃO  → planilha REAL "Mestres do Algoritmo | OCDM" (conta dona = MDA).
#   dev/hist. → CÓPIA congelada de 2026-07-07: 1Y2swiHYvyxYADG6rD1hKuu8LTyM_lvx8GJue6zk0y3A
SHEET_ID=

# --- modo sheet-api: nomes das abas (gid NÃO é estável entre cópia e real) ---
# Só preencha se a planilha real renomear alguma aba; os defaults do código já são estes.
SHEET_TAB_LEADS=LEADS
SHEET_TAB_AGENDAMENTOS=AGENDAMENTOS & CALL
SHEET_TAB_VENDAS=VENDAS
SHEET_TAB_MIDIA_DIARIA=ACOMPANHAMENTO DIÁRIO
SHEET_TAB_MIDIA_PUBLICO=TOP PÚBLICOS
SHEET_TAB_MIDIA_ANUNCIO=MÉTRICAS ADS

# --- modo sheet-csv: gids (da CÓPIA de 2026-07-07; NÃO valem para a planilha real) ---
SHEET_GID_LEADS=563141629
SHEET_GID_AGENDAMENTOS=1902127266
SHEET_GID_VENDAS=7064037
SHEET_GID_MIDIA_DIARIA=1191656695
SHEET_GID_MIDIA_PUBLICO=412418203
SHEET_GID_MIDIA_ANUNCIO=449290879
# RESPOSTAS é redundante (LEADS já traz MQL) — não usado na V1.
SHEET_GID_RESPOSTAS=1946617532

# --- modo sheet-api (produção) ---
# Chave JSON da service account DA MDA (projeto GCP próprio — não misturar com REDE F).
# Path relativo resolve a partir da raiz do projeto. service-account*.json já é gitignored.
# Setup passo a passo: docs/runbook.md § "Service account (sheet-api)".
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account-mda.json

# --- sync ---
SYNC_INTERVAL_MINUTES=20
TIMEZONE=America/Sao_Paulo
CURRENCY=BRL
# Ticket usado só como fallback quando a venda não traz valor (glossário §4: valor real vence)
DEFAULT_TICKET=4297

# --- servidor ---
PORT=8080
HOST=127.0.0.1

# --- segurança (Epic 5) ---
# Domínio do time Cloudflare Access (ex.: kaubymedia.cloudflareaccess.com)
CF_ACCESS_TEAM_DOMAIN=
# AUD tag do app Access
CF_ACCESS_AUD=
# Em dev, pular validação do JWT do Access (SOMENTE localhost)
AUTH_BYPASS=true

# --- Meta Marketing API (anúncios + públicos) ---
# Substitui a automação do gestor de tráfego que parou de preencher MÉTRICAS ADS e
# TOP PÚBLICOS em 2026-06-23. Read-only: só GET em /insights. Sem estas duas primeiras
# variáveis o dashboard roda igual antes, só com a planilha.
# Token: idealmente de SYSTEM USER da Business Manager (não expira). Token de usuário
# expira em ~60 dias e o sync passa a avisar com erro 190.
META_ACCESS_TOKEN=
# Só os dígitos — o prefixo act_ é adicionado pelo código.
META_AD_ACCOUNT_ID=
META_API_VERSION=v23.0
# Primeiro dia do backfill inicial (a Meta guarda ~37 meses de insights).
META_SINCE=2024-12-01
# Janela repuxada a cada sync (a Meta revisa atribuição por ~28 dias).
META_REFRESH_DAYS=35
# Dias por requisicao. O backfill inteiro num pedido so e recusado pela Meta
# ("Please reduce the amount of data you're asking for").
META_CHUNK_DAYS=92
# Funil dos RELATÓRIOS por anúncio/público: ocdm | c2 | outro. Fica só OCDM: existe
# AD02 [OCDM] e AD02 [C2], e o utm_content do lead só carrega o número (video-ad02).
META_FUNIL=ocdm
# Funis somados no INVESTIMENTO do dia (gasto/impressões/cliques), separados por vírgula.
# Default ocdm,c2 desde 2026-08-12: os leads do C2 caem na MESMA aba LEADS e contam como
# pago, então o gasto dele tem que estar no numerador do CPL. Campanha sem tag fica fora.
META_FUNIS_GASTO=ocdm,c2
# true = investimento/impressões/cliques do dia vêm da Meta com o recorte acima.
# false = fica o total da CONTA que a coluna Gasto da ACOMPANHAMENTO traz.
META_APPLY_SPEND=true
# META_ENABLED=false desliga sem apagar as credenciais.
