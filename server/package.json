{
  "name": "@mda/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --experimental-sqlite --import tsx/esm src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-sqlite --import tsx/esm --test --test-reporter spec test/units.test.ts test/metrics.test.ts test/db.test.ts",
    "sync": "node --experimental-sqlite --import tsx/esm src/cli/sync.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
